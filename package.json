{
  "name": "hermit-console",
  "version": "1.2.1",
  "description": "A local console for comparing git releases across repositories and reconciling Jira releases and worklogs.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "hermit": "bin/hermit.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "web/dist/",
    "README.md",
    "AGENT.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudrevel-lab/hermit.git"
  },
  "bugs": {
    "url": "https://github.com/cloudrevel-lab/hermit/issues"
  },
  "homepage": "https://github.com/cloudrevel-lab/hermit#readme",
  "keywords": [
    "git",
    "release",
    "azure-devops",
    "github",
    "jira",
    "cherry-pick",
    "worklog"
  ],
  "scripts": {
    "build": "vite build",
    "server": "node server/index.mjs",
    "dev:web": "vite",
    "hermit": "node bin/hermit.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "set-npm-token": "node scripts/set-npm-token.mjs",
    "prepack": "vite build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lowdb": "^7.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.42",
    "vue-router": "^4.5.0",
    "vuetify": "^4.2.0",
    "@mdi/font": "^7.4.47",
    "sass-embedded": "^1.83.0"
  }
}
